<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  online.tokeniko.api — the FastAPI server (the compilation pipeline + the REST surface).

  Installed by the Captain's hand:
      cp scripts/body/online.tokeniko.api.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/online.tokeniko.api.plist

  The paths below are ABSOLUTE and hardcode the username and the repo location. The mini must use
  the SAME username and the SAME repo path, or these three plists need regenerating (and so does
  docker-compose.yml, whose volume paths are absolute too).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>online.tokeniko.api</string>

    <!-- the wrapper, never uvicorn directly: launchd has no dependency ordering and init_io dies
         on an unreachable Mongo. run_service.sh polls first, then execs — so the PID launchd
         supervises is the real service. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/renzosala/Develop/personal/tokeniko/scripts/body/run_service.sh</string>
        <string>api</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- the whole unattended story: a crash, an OOM, a Mongo-timeout exit — all restart themselves. -->
    <key>KeepAlive</key>
    <true/>

    <!-- do not let a genuinely broken config (missing venv, missing .env) spin a tight crash loop
         writing gigabytes of log; 30s between attempts is still "immediately" for a body. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>WorkingDirectory</key>
    <string>/Users/renzosala/Develop/personal/tokeniko/tokeniko-tk1</string>

    <key>StandardOutPath</key>
    <string>/Users/renzosala/Develop/personal/tokeniko/tokeniko-tk1/logs/api.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/renzosala/Develop/personal/tokeniko/tokeniko-tk1/logs/api.err.log</string>

    <!-- MINIMAL, and NEVER a secret: the wrapper sources .env itself. This is only the PATH a
         launchd session does not inherit from a login shell. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- ProcessType IS DELIBERATELY ABSENT. Setting it to Background invites launchd's CPU and I/O
         throttling, and the mind must run at full speed on its own machine. Do not "helpfully"
         add it. (Runbook §1.2.) -->
</dict>
</plist>
